[node name="SneakTutorialPopup" type="Node2D" parent="."]
script = ExtResource("9")
grid_cell = Vector2i(32, 30)
trigger_radius = 1
auto_save_on_trigger = false
tutorial_id = "sneak_mechanic"
tutorial_title = "Sneaking"
tutorial_body = "Press Z (or click the Sneak button) to enter sneak mode. While sneaking, enemies don't spot you automatically — each has a chance to notice you as you move, based on your Sneak skill against their Perception, and that chance gets worse the closer you are and in brighter light. Watchful enemies show a ring around them: red where they can actually see you, blue where a rock or wall blocks their line of sight — step through the blue and their detection there drops to nothing. Use cover to slip past unseen, or get close enough for a sneak attack.\n\nIf that's hard to track in real time, press T to enter tactical mode — everyone, including enemies, moves turn by turn instead of all at once, making it much easier to time your steps around a patrol."

[node name="AltHighlightTutorialPopup" type="Node2D" parent="."]
script = ExtResource("9")
trigger_on_visible_cell = Vector2i(46, 16)
tutorial_id = "alt_highlight"
tutorial_title = "Spotting Interactables"
tutorial_body = "Hold Alt to highlight everything nearby you can interact with — items, containers, doors, and levers — even ones easy to miss at a glance."

[node name="CarveTutorialPopup" type="Node2D" parent="."]
script = ExtResource("9")
grid_cell = Vector2i(19, 29)
trigger_radius = 8
auto_save_on_trigger = false
wait_for_dead = PackedStringArray("Roach1", "Roach2", "Roach3", "Roach4")
tutorial_id = "carve_mechanic"
tutorial_title = "Carving Corpses"
tutorial_body = "Animal corpses can be carved for meat and other resources — right-click one and choose Carve. How much you get, and its quality, depends on your Survival skill."

[node name="ExitTutorialMessage" type="Node2D" parent="."]
