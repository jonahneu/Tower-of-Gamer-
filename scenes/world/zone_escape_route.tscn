[node name="Roach1" type="Node2D" parent="."]
script = ExtResource("4")
grid_cell = Vector2i(16, 28)
tutorial_gate_id = "combat_basics"
tutorial_gate_title = "Combat"
tutorial_gate_body = "Combat is turn-based — the order everyone acts in is shown along the top of the screen. On your turn you have MP (movement points) to move and AP (action points) to act; the grey circle around you shows how far MP can take you, and the yellow circle beyond it shows how much further you can move by spending AP instead once MP runs out. Spend AP from the hotbar along the bottom of the screen to attack or use an ability. Life totals show as health bars above everyone in the fight — right-click an enemy to inspect their status effects. The combat log on the right side of the screen records every roll and hit, so you can follow exactly what happened. Close to continue."

