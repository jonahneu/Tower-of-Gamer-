tutorial_gate_title = "Locked Containers"
tutorial_gate_body = "That chest is locked. You can open it with the matching key if you're carrying one, or work the lock with your Sleight of Hand skill — no roll involved, just a flat check against the lock's difficulty. High enough skill opens it without a key at all."
