[node name="MakeCampTutorialPopup" type="Node2D" parent="."]
script = ExtResource("4")
grid_cell = Vector2i(8, 29)
trigger_radius = 8
auto_save_on_trigger = false
tutorial_id = "make_camp_mechanic"
tutorial_title = "Making Camp"
tutorial_body = "Press R (or click the Rest button) to Make Camp. From there you can cook a meal if you have ingredients and a known recipe — you start knowing Simple Meal, and any meat you carved off the roaches works as an ingredient — then Rest to restore HP and Spirit. Cooking skill improves what a cooked meal does for you; higher Survival got you better carving results earlier, and it's worth resting here before heading out."

[node name="ExhaustionTutorialPopup" type="Node2D" parent="."]
script = ExtResource("4")
trigger_on_player_rested = true
auto_save_on_trigger = false
tutorial_id = "exhaustion_mechanic"
tutorial_title = "Exhaustion"
tutorial_body = "You rested without spiritual protection, so you're now Exhausted. Each stack of Exhaustion is a flat -10% to every dice roll and skill check you make — combat, crafting, all of it — until it's cleared. Resting again with adequate spiritual protection clears it completely; resting again without it only piles more stacks on. Worth finding real protection soon."
