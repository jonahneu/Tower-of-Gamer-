tutorial_id = "make_camp_mechanic"
tutorial_title = "Making Camp"
tutorial_body = "Press R (or click the Rest button) to Make Camp. From there you can cook a meal if you have ingredients and a known recipe — you start knowing Simple Meal, and any meat you carved off the roaches works as an ingredient — then Rest to restore HP and Spirit. Cooking skill improves what a cooked meal does for you; higher Survival got you better carving results earlier, and it's worth resting here before heading out."

